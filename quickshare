#!/usr/bin/env bash
# Quick Share for Omarchy: a thin wrapper around quickshare-direct, which speaks
# Google/Samsung Quick Share over Bluetooth (+ Wi-Fi Direct when it can), so the
# phone and PC don't need to share a Wi-Fi network.
#
#   quickshare status              JSON: installed, receiving, fast, sending
#   quickshare receive on|off|toggle  turning it off mid-transfer needs --force
#   quickshare send [file...]      send to a device in receive mode; no args opens a picker
#   quickshare cancel              stop the send in progress
#   quickshare devices             list phones in receive mode nearby
#   quickshare downloads           open the folder received files go to
#   quickshare fast on|off         Wi-Fi Direct for transfers (the PC's Wi-Fi stays up if it can)
#   quickshare audio [off|MB]      Bluetooth headphones drop to a lower bitrate for bigger transfers
#   quickshare trust [add|remove NAME]  devices whose files are accepted without asking
#   quickshare menu                everything above in an Omarchy menu (the bar's right click)
#   quickshare doctor              check the setup and say how to fix what's missing
set -uo pipefail

here=$(dirname "$(readlink -f "$0")")
unit=quickshare-direct.service
fast_helper=/usr/local/lib/omarchy-quickshare/quickshare-fastlink
fast_dropin=/etc/systemd/system/quickshare-ap@.service.d/50-omarchy-fastlink.conf
# The D-Bus policy quickshare-fastlink holds for about a second while a group starts.
hold_policy=/etc/dbus-1/system.d/zz-quickshare-hold-group.conf
env_file=$HOME/.config/quickshare-direct/env
trusted_file=$HOME/.config/quickshare-direct/trusted
# Transfers from this size (MB) lower the headphones' bitrate ("off": never); see audio_guard.
audio_file=$HOME/.config/quickshare-direct/audio
audio_unit=quickshare-audio-guard.service
cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/quickshare-direct
state_dir=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshare
# The send in progress, for the bar: {pid, title, detail, result, at}. Our notify-send shim
# keeps title/detail up to date from quickshare-direct's own status notifications.
send_state=$state_dir/send.json
# Headphones whose codec audio_guard lowered: card<TAB>profile before<TAB>profile it set.
audio_state=$state_dir/audio-switched

# Our notify-send shim turns Accept/Decline (and the "several devices" question)
# into an Omarchy menu; see bin/notify-send.
export PATH="$here/bin:${OMARCHY_PATH:-/usr/share/omarchy}/bin:$PATH"

die() { echo "quickshare: $*" >&2; exit 1; }

installed() { command -v quickshare-direct >/dev/null 2>&1; }
receiving() { systemctl --user is-active --quiet "$unit"; }
fast() { [[ -e $fast_dropin ]]; }
send_pid() { jq -r '.pid // 0' "$send_state" 2>/dev/null || echo 0; }
sending() { local p; p=$(send_pid); [[ $p != 0 ]] && kill -0 "$p" 2>/dev/null; }

status() {
  local inst=false recv=false fst=false snd=false
  installed && inst=true
  receiving && recv=true
  fast && fst=true
  sending && snd=true
  # The bar watches the state file, which has to exist for that; a send that died without
  # clearing it (SIGKILL) is cleared here.
  if [[ ! -e $send_state ]] || { [[ $snd == false && $(send_pid) != 0 ]]; }; then
    set_send_state 0 "" "" ""
  fi
  printf '{"installed":%s,"receiving":%s,"fast":%s,"sending":%s}\n' "$inst" "$recv" "$fst" "$snd"
}

set_send_state() {
  mkdir -p "$state_dir"
  jq -nc --argjson pid "$1" --arg title "$2" --arg detail "$3" --arg result "$4" --argjson at "$(date +%s)" \
    '{pid: $pid, title: $title, detail: $detail, result: $result, at: $at}' > "$send_state.tmp" &&
    mv -f "$send_state.tmp" "$send_state"
}

# The name of the file the receiver is writing right now (a transfer in progress), or fail.
# Idle, it holds nothing but sockets and /dev/null; while receiving, the incoming file is open
# for writing.
incoming_file() {
  local pid fd target flags
  pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
  [[ -n $pid && $pid != 0 ]] || return 1
  for fd in /proc/"$pid"/fd/*; do
    (( ${fd##*/} > 2 )) || continue # stdout may be a log file when run by hand
    target=$(readlink "$fd" 2>/dev/null) || continue
    [[ $target == /* && $target != /dev/* && $target != /proc/* && $target != /sys/* && -f $target ]] || continue
    flags=$(awk '/^flags:/ {print $2; exit}' "/proc/$pid/fdinfo/${fd##*/}" 2>/dev/null)
    (( 8#${flags:-0} & 3 )) || continue # O_WRONLY or O_RDWR
    printf '%s\n' "${target##*/}"
    return 0
  done
  return 1
}

# enable/disable too, so the choice survives a re-login. Turning it off while a file is still
# coming in cuts the transfer, so that takes --force (the menu asks instead). Every stop is
# logged (journalctl -t quickshare): a stop mid-transfer once looked like a network stall.
set_receive() {
  installed || die "quickshare-direct is not installed"
  local want=${1:-toggle} force=${2:-} from=${3:-the command line} file=
  [[ -z $force || $force == --force ]] || die "receive takes on, off or toggle (and --force with off)"
  if [[ $want == toggle ]]; then
    if receiving; then want=off; else want=on; fi
  fi
  case $want in
    on) systemctl --user enable --now "$unit" ;;
    off)
      if receiving; then
        if file=$(incoming_file) && [[ $force != --force ]]; then
          die "$file is still coming in; \`quickshare receive off --force\` stops it anyway"
        fi
        logger -t quickshare "receiver stopped from $from${file:+ while $file was still coming in}"
      fi
      systemctl --user disable --now "$unit" ;;
    *) die "receive takes on, off or toggle" ;;
  esac
}

# The menu's "Stop receiving": ask first while a file is still coming in.
menu_stop_receiving() {
  local file choice
  if file=$(incoming_file); then
    choice=$(printf '%s\n' $'\U000f0497\tKeep receiving' $'\U000f1514\tStop anyway' |
      omarchy-menu-select "$file is still coming in" -- --width 500) || return 0
    [[ $choice == "Stop anyway" ]] || return 0
  fi
  set_receive off --force "the menu"
}

# Bluetooth headphones and Wi-Fi Direct. The Wi-Fi card does Bluetooth too (Intel AX210: one chip,
# shared antennas), and the Wi-Fi Direct link runs on 2.4 GHz, where Bluetooth lives. A
# high-bitrate stream such as LDAC takes so much airtime that transfers crawl at ~1 MB/s with stalls
# of several seconds instead of 5-6 MB/s (measured 2026-11-14, docs/wifi-direct-notes.md). So while
# a transfer of at least `quickshare audio` MB runs over our Wi-Fi Direct group or hotspot,
# connected headphones on such a codec switch to AAC (else SBC), and switch back when it ends.
# Transfers over the home network (5 GHz there) and over Bluetooth are left alone.
audio_threshold() {
  local v
  v=$(cat "$audio_file" 2>/dev/null)
  if [[ $v == off || $v =~ ^[0-9]+$ ]]; then echo "$v"; else echo 50; fi
}

# "card<TAB>active profile<TAB>lower profile" for each Bluetooth card playing A2DP on a codec heavier
# than AAC/SBC (LDAC, aptX (HD), SBC-XQ, Opus, ...) that offers AAC or SBC.
audio_heavy_cards() {
  pactl -f json list cards 2>/dev/null | jq -r '
    .[] | select(.name | startswith("bluez_card."))
    | .active_profile as $p | .profiles as $all
    | select($p | startswith("a2dp-sink"))
    | select(($all[$p].description // "") | test("codec (SBC|AAC|FastStream)\\)") | not)
    | (if $all["a2dp-sink-aac"].available then "a2dp-sink-aac"
       elif $all["a2dp-sink-sbc"].available then "a2dp-sink-sbc" else empty end) as $to
    | select($to != $p)
    | "\(.name)\t\($p)\t\($to)"' 2>/dev/null
}

# Media players (MPRIS bus names) that are playing right now.
playing_players() {
  local p
  for p in $(busctl --user list --no-legend 2>/dev/null | awk '$1 ~ /^org\.mpris\.MediaPlayer2\./ {print $1}'); do
    [[ $(busctl --user get-property "$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player \
      PlaybackStatus 2>/dev/null) == 's "Playing"' ]] && echo "$p"
  done
  return 0
}

# Switch a Bluetooth card to another profile without stopping the music. The codec change takes
# the headphones' output away for about half a second, and players that see their output vanish
# pause (Spotify does). The ones that were playing get Play once the new output is up.
switch_profile() {  # card profile
  local card=$1 profile=$2 players p left
  players=$(playing_players)
  pactl set-card-profile "$card" "$profile" 2>/dev/null || return 1
  [[ -n $players ]] || return 0
  for _ in $(seq 30); do  # the new output, up to 3 s
    pactl list short sinks 2>/dev/null | grep -q "bluez_output\.${card#bluez_card.}" && break
    sleep 0.1
  done
  # A player may pause a moment after the switch: watch for 2 s.
  for _ in $(seq 20); do
    sleep 0.1
    left=
    for p in $players; do
      if [[ $(busctl --user get-property "$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player \
        PlaybackStatus 2>/dev/null) == 's "Paused"' ]]; then
        busctl --user call "$p" /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player Play 2>/dev/null &&
          logger -t quickshare "resumed ${p#org.mpris.MediaPlayer2.} after the headphones' codec switch"
      else
        left+=" $p"
      fi
    done
    players=$left
    [[ -n $players ]] || break
  done
  return 0
}

audio_lower() {
  local name from to switched=0
  mkdir -p "$state_dir"
  while IFS=$'\t' read -r name from to; do
    [[ -n $name ]] || continue
    switch_profile "$name" "$to" || continue
    printf '%s\t%s\t%s\n' "$name" "$from" "$to" >> "$audio_state"
    logger -t quickshare "headphones $name: $from -> $to for a $1 MB transfer"
    switched=1
  done < <(audio_heavy_cards)
  (( switched )) && notify-send --app-name="Quick Share" --icon=audio-headphones --expire-time=6000 \
    "Headphones on a lower bitrate" "Bluetooth audio slows Wi-Fi Direct down; back to normal when this $1 MB transfer ends."
  return 0
}

# Put back what audio_lower changed, unless the profile was changed again since.
audio_restore() {
  local name from to now
  [[ -s $audio_state ]] || return 0
  while IFS=$'\t' read -r name from to; do
    now=$(pactl -f json list cards 2>/dev/null | jq -r --arg n "$name" '.[] | select(.name == $n) | .active_profile')
    if [[ $now == "$to" ]] && switch_profile "$name" "$from"; then
      logger -t quickshare "headphones $name: back to $from"
    fi
  done < "$audio_state"
  rm -f "$audio_state"
}

# The service (quickshare-audio-guard.service, started and stopped with the receiver): follow the
# receiver's log. The size comes with the consent prompt; the group/hotspot logs "Hotspot: X up"
# once it's ready (before the phone joins) and "Hotspot: stopping" at the end.
audio_guard() {
  local line total=0 link=0 thr
  audio_restore  # left over from a guard that was killed
  trap audio_restore EXIT
  trap 'exit 0' TERM INT
  while IFS= read -r line; do
    case $line in
      *"RemoteDeviceInfo:"*) total=0 ;;
      *"Asking for user consent"*) [[ $line =~ total_bytes:\ ([0-9]+) ]] && total=${BASH_REMATCH[1]} ;;
      *"Hotspot: "*" up "*) link=1 ;;
      *"Hotspot: stopping"* | *"Transfer finished"* | *"Transfer canceled"* | *declined* | *"Stopping."*)
        link=0 total=0
        audio_restore
        continue ;;
      *) continue ;;
    esac
    thr=$(audio_threshold)
    if (( link )) && [[ $thr != off ]] && (( total >= thr * 1000000 )) && [[ ! -s $audio_state ]]; then
      audio_lower $(( total / 1000000 ))
    fi
  done < <(journalctl --user -u "$unit" -f -n 0 -o cat)
}

set_audio() {
  local v=${1:-}
  case $v in
    '') if [[ $(audio_threshold) == off ]]; then echo off; else echo "on: transfers from $(audio_threshold) MB"; fi ;;
    off | 0) mkdir -p "${audio_file%/*}"; echo off > "$audio_file"; echo "Headphones keep their codec during transfers" ;;
    *)
      [[ $v =~ ^[0-9]+$ ]] || die "audio takes off or a size in MB (default 50)"
      mkdir -p "${audio_file%/*}"
      echo "$v" > "$audio_file"
      echo "Bluetooth headphones drop to AAC/SBC while a transfer of $v MB or more runs over Wi-Fi Direct" ;;
  esac
}

# quickshare-direct's own Wi-Fi Direct link dies at once under NetworkManager, so
# transfers stay on Bluetooth (~7 KB/s). "fast on" swaps in system/quickshare-fastlink,
# which keeps the group alive next to the Wi-Fi connection, or else takes the Wi-Fi away
# from NetworkManager for the transfer. It runs as root,
# so it's copied to /usr/local (root-owned), never run from this user-writable folder.
set_fast() {
  installed || die "quickshare-direct is not installed"
  case ${1:-} in
    on)
      pkexec /bin/sh -c 'install -Dm755 "$1" "$3" && install -Dm644 "$2" "$4" && systemctl daemon-reload' sh \
        "$here/system/quickshare-fastlink" "$here/system/quickshare-ap@.service.d/50-omarchy-fastlink.conf" \
        "$fast_helper" "$fast_dropin" || die "not installed"
      echo "Wi-Fi Direct on: transfers keep this PC's Wi-Fi connected where the card allows it" ;;
    off)
      pkexec /bin/sh -c 'rm -f "$1" "$2" && rmdir --ignore-fail-on-non-empty "${2%/*}" "${1%/*}"; systemctl daemon-reload' sh \
        "$fast_helper" "$fast_dropin" || die "not removed"
      echo "Wi-Fi Direct off: transfers use Bluetooth" ;;
    *) fast && echo on || echo off ;;
  esac
}

# Phones on their receive screen only announce themselves after hearing a "device nearby is
# sharing" beacon (Samsung not at all without it), which quickshare-direct doesn't send; see
# scripts/qs-beacon. Optional: without python-dbus/python-gobject sending works as before.
beacon_pid=
beacon_on() {
  python3 -I -c 'import dbus, gi' 2>/dev/null || return 0
  python3 -I "$here/scripts/qs-beacon" "${1:-120}" >/dev/null 2>&1 &
  beacon_pid=$!
}
beacon_off() {
  [[ -n $beacon_pid ]] && kill "$beacon_pid" 2>/dev/null
  beacon_pid=
  return 0
}

# Run quickshare-direct in the background so `quickshare cancel` (SIGINT) reaches it: its own
# ctrl-c handling cancels the transfer and leaves the phone's network. --default-signal undoes
# the ignored SIGINT a non-interactive shell gives background jobs (during the scan, before
# quickshare-direct handles it, SIGINT simply ends it).
child=
run_direct() {
  env --default-signal=INT quickshare-direct "$@" > "$state_dir/send.out" 2>&1 &
  child=$!
  local code
  while :; do
    wait "$child"; code=$?
    kill -0 "$child" 2>/dev/null || break
  done
  child=
  return "$code"
}
forward_cancel() {
  [[ -n $child ]] || return 0
  kill -INT "$child" 2>/dev/null
  # Still running 5 s later: it didn't take the hint.
  (sleep 5; kill -TERM "$child" 2>/dev/null) &
}

send() {
  installed || die "quickshare-direct is not installed"
  local files=() f to="" code names last title
  if (( $# == 0 )); then
    f=$(bash "$here/scripts/pick_file.sh") || exit 0
    [[ -n $f ]] || exit 0
    files=("$f")
  else
    for f in "$@"; do
      [[ -e $f ]] || die "no such file: $f"
      if [[ ! -f $f ]]; then
        notify-send --app-name="Quick Share" "Quick Share: nothing sent" "${f##*/} is a folder; Quick Share sends files only."
        die "not a file: $f"
      fi
      files+=("$(readlink -f "$f")")
    done
  fi

  mkdir -p "$state_dir" "$cache_dir"
  export QS_SEND_STATE=$send_state
  set_send_state $$ "Quick Share" "Looking for a phone…" ""
  trap 'forward_cancel' INT TERM
  trap 'beacon_off' EXIT
  beacon_on 120

  # quickshare-direct posts its own "Looking for a phone…" and result notifications.
  run_direct send "${files[@]}"
  code=$?

  # Several devices in receive mode: ask which one (the last one we sent to first), then send
  # again with --to. The names come in that notification, which the shim saved.
  if (( code == 2 )); then
    names=$(jq -r '.detail' "$send_state" 2>/dev/null | sed -n 's/.*pick one with --to NAME: *//p' |
      tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep .)
    last=$(cat "$cache_dir/last-target" 2>/dev/null)
    if [[ -n $last ]] && grep -qxF "$last" <<< "$names"; then
      names=$(printf '%s\n' "$last"; grep -vxF "$last" <<< "$names")
    fi
    if [[ -n $names ]] && to=$(omarchy-menu-select "Send ${files[0]##*/} to" -- --width 500 <<< "$names"); then
      set_send_state $$ "Quick Share" "Connecting to $to…" ""
      run_direct send --to "$to" "${files[@]}"
      code=$?
    else
      code=130
    fi
  fi

  title=$(jq -r '.title' "$send_state" 2>/dev/null)
  case $code in
    0)
      [[ $title == Sent\ *\ to\ * ]] && printf '%s\n' "${title##* to }" > "$cache_dir/last-target"
      set_send_state 0 "$title" "" sent ;;
    130)
      # Cancelled while still looking, quickshare-direct had no time to say so.
      [[ $title == "Quick Share: cancelled" ]] || notify-send --app-name="Quick Share" "Quick Share: cancelled" "${files[0]##*/}"
      set_send_state 0 "Quick Share: cancelled" "" cancelled ;;
    *) set_send_state 0 "$title" "$(jq -r '.detail' "$send_state" 2>/dev/null)" failed ;;
  esac
  if (( code != 0 && code != 130 )); then
    cat "$state_dir/send.out" >&2
  fi
  exit "$code"
}

cancel() {
  local p
  p=$(send_pid)
  if [[ $p == 0 ]] || ! kill -0 "$p" 2>/dev/null; then die "nothing is being sent"; fi
  kill -INT "$p"
}

devices() {
  installed || die "quickshare-direct is not installed"
  trap 'beacon_off' EXIT
  beacon_on 30
  quickshare-direct devices
  local code=$?
  # Phones also announce themselves on the Wi-Fi network (mDNS). quickshare-direct only sends over
  # Bluetooth, but a phone listed here and not above narrows down why sending finds nothing.
  command -v avahi-browse >/dev/null || return "$code"
  echo "On this Wi-Fi network:"
  timeout 5 avahi-browse -rpt _FC9F5ED42C8A._tcp 2>/dev/null | python3 -I -c '
import base64, sys
seen = set()
for line in sys.stdin:
    f = line.rstrip("\n").split(";")
    if len(f) < 10 or f[0] != "=" or f[2] != "IPv4" or f[7] in seen:
        continue
    seen.add(f[7])
    n = next((t[2:] for t in f[9].replace("\"", "").split(" ") if t.startswith("n=")), "")
    try:
        b = base64.urlsafe_b64decode(n + "=" * (-len(n) % 4))
    except ValueError:
        continue
    kind = {1: "phone", 2: "tablet", 3: "computer"}.get((b[0] >> 1) & 7, "device")
    if len(b) > 17 and b[17]:
        name = b[18:18 + b[17]].decode(errors="replace")
        print(f"  {name} ({kind}, {f[7]})")
    else:
        print(f"  a {kind} visible only to its own contacts ({f[7]})")
' || echo "  (none)"
  return "$code"
}

# Senders whose transfers bin/notify-send accepts without asking, one device name per line (as the
# phone calls itself, e.g. "Emanuel's Tab S9+"). Names aren't verified: anyone nearby can call
# their phone the same.
trust() {
  local name=${2:-}
  case ${1:-list} in
    list) [[ -s $trusted_file ]] && cat "$trusted_file"; return 0 ;;
    add)
      [[ -n $name ]] || die "trust add takes a device name"
      mkdir -p "${trusted_file%/*}"
      grep -qxF "$name" "$trusted_file" 2>/dev/null || printf '%s\n' "$name" >> "$trusted_file"
      echo "Files from $name are now accepted without asking" ;;
    remove)
      [[ -n $name ]] || die "trust remove takes a device name"
      [[ -f $trusted_file ]] && grep -vxF "$name" "$trusted_file" > "$trusted_file.tmp"
      mv -f "$trusted_file.tmp" "$trusted_file" 2>/dev/null
      echo "Files from $name need an Accept again" ;;
    *) die "trust takes list, add NAME or remove NAME" ;;
  esac
}

# One line per part of the setup: ✓ fine, ! worth knowing, ✗ broken (with the fix). Exits 1 on any ✗.
doctor() {
  local g='' y='' r='' n='' bad=0 v cc pid sta phy
  [[ -t 1 ]] && g=$'\e[32m' y=$'\e[33m' r=$'\e[31m' n=$'\e[0m'
  pass() { printf '  %s✓%s %s\n' "$g" "$n" "$1"; }
  warn() { printf '  %s!%s %s\n' "$y" "$n" "$1"; }
  fail() { printf '  %s✗%s %s\n      fix: %s\n' "$r" "$n" "$1" "$2"; bad=1; }

  if installed; then
    v=$(pacman -Q quickshare-direct 2>/dev/null | awk '{print $2}')
    pass "quickshare-direct ${v:-installed}"
  else
    fail "quickshare-direct isn't installed" "$here/install.sh"
  fi

  if receiving; then
    pass "Receiving: phones can pick $(sed -n 's/^QSD_NAME=//p' "$env_file" 2>/dev/null | tail -1 | grep . || uname -n)"
  else
    fail "Receiving is off, so phones can't see this PC" "quickshare receive on"
  fi

  if [[ $(timeout 3 bluetoothctl show 2>/dev/null) == *'Powered: yes'* ]]; then
    pass "Bluetooth on"
  else
    fail "Bluetooth is off or missing" "bluetoothctl power on"
  fi
  if installed && ! systemctl is-enabled -q quickshare-bt-connectable.service 2>/dev/null; then
    fail "Bluetooth isn't kept connectable for phones" "sudo systemctl enable --now quickshare-bt-connectable"
  fi
  if python3 -I -c 'import dbus, gi' 2>/dev/null; then
    pass "Sending wakes up phones on their receive screen"
  else
    warn "Sending can't wake up phones, so Samsung phones aren't found (sudo pacman -S python-dbus python-gobject)"
  fi

  if grep -q "^PATH=$here/bin:" "$env_file" 2>/dev/null; then
    pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
    if [[ ${pid:-0} != 0 ]] && ! grep -qz "^PATH=$here/bin:" "/proc/$pid/environ" 2>/dev/null; then
      fail "The receiver started before its prompts were routed" "systemctl --user restart $unit"
    else
      pass "Accept/Decline prompts open as an Omarchy menu"
    fi
  else
    fail "Accept/Decline prompts can't be answered (Omarchy popups have no buttons)" "$here/install.sh"
  fi
  [[ -s $trusted_file ]] && pass "Accepted without asking: $(paste -sd ',' "$trusted_file" | sed 's/,/, /g')"

  [[ -f $HOME/.local/share/icons/hicolor/scalable/apps/omarchy-quickshare.svg ]] ||
    warn "Notifications show a letter instead of the Quick Share icon ($here/install.sh installs it)"

  if systemctl is-active -q ufw 2>/dev/null; then
    if grep -q 'quickshare-direct' /etc/ufw/user.rules 2>/dev/null; then
      pass "Firewall: ufw allows quickshare-direct"
    else
      fail "Firewall: ufw blocks transfers over your Wi-Fi network" "sudo ufw allow quickshare-direct"
    fi
  fi

  # Intel cards keep their own region ("phy#0 (self-managed)"), learned from nearby networks; the
  # global one doesn't apply to them.
  sta=$(iw dev 2>/dev/null | awk '/Interface/{i=$2} /type managed/{print i; exit}')
  phy=$(cat "/sys/class/net/$sta/phy80211/name" 2>/dev/null)
  cc=$(iw reg get 2>/dev/null | awk -v want="phy#${phy#phy}" '
    $1 == want && /self-managed/ { s = 1; next } /^(global|phy#)/ { s = 0 }
    s && /^country/ { sub(":", "", $2); print $2; exit }')
  if [[ -n $cc ]]; then
    pass "Wi-Fi region: $cc (set by the Wi-Fi card)"
  else
    cc=$(iw reg get 2>/dev/null | awk '/^global/ { g = 1; next } g && /^country/ { sub(":", "", $2); print $2; exit }')
    if [[ -n $cc && $cc != 00 ]]; then
      pass "Wi-Fi region: $cc"
    else
      warn "Wi-Fi region not set, so direct Wi-Fi stays on 2.4 GHz (sudo iw reg set XX, or $here/install.sh)"
    fi
  fi

  if [[ $(iw phy 2>/dev/null) == *P2P-GO* ]]; then
    if fast && ! { cmp -s "$here/system/quickshare-fastlink" "$fast_helper" &&
      cmp -s "$here/system/quickshare-ap@.service.d/50-omarchy-fastlink.conf" "$fast_dropin"; }; then
      fail "Fast Wi-Fi: its helper doesn't match this version of the plugin" "quickshare fast on"
    elif fast; then pass "Fast Wi-Fi: on"
    else warn "Fast Wi-Fi: off, transfers use Bluetooth (quickshare fast on)"; fi
    if [[ $(audio_threshold) == off ]]; then
      warn "Headphones keep their codec during transfers; Bluetooth audio slows Wi-Fi Direct (quickshare audio 50)"
    elif ! systemctl --user is-enabled -q "$audio_unit" 2>/dev/null; then
      fail "Headphones: the service that lowers their bitrate during transfers isn't set up" "$here/install.sh"
    elif receiving && ! systemctl --user is-active -q "$audio_unit"; then
      fail "Headphones: the service that lowers their bitrate during transfers isn't running" "systemctl --user restart $unit"
    else
      pass "Headphones: lower bitrate during transfers from $(audio_threshold) MB"
    fi
    if [[ -e $hold_policy ]] && ! systemctl is-active -q "quickshare-ap@$USER.service"; then
      fail "Fast Wi-Fi: a D-Bus policy from a helper that died is still in place" \
        "sudo sh -c 'rm $hold_policy && busctl call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus ReloadConfig'"
    fi
  else
    warn "This Wi-Fi card can't do Wi-Fi Direct, so transfers use Bluetooth"
  fi

  if omarchy-plugin-list --json 2>/dev/null | jq -e 'any(.[]; .id == "emanuel.quickshare" and .enabled)' >/dev/null; then
    pass "Bar icon on"
  else
    fail "Bar icon off" "omarchy plugin enable emanuel.quickshare"
  fi

  if [[ $(readlink -f "$HOME/.local/bin/quickshare" 2>/dev/null) != "$here/quickshare" ]]; then
    warn "The quickshare command isn't in ~/.local/bin ($here/install.sh links it)"
  fi
  return "$bad"
}

downloads_dir() { xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads"; }

latest_screenshot() {
  local dir=${OMARCHY_SCREENSHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")}
  find "$dir" -maxdepth 1 -type f -iname '*.png' -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2-
}

# Add the last sender that asked, or remove a trusted one.
trust_menu() {
  local rows=() last choice name
  last=$(cat "$cache_dir/last-sender" 2>/dev/null)
  if [[ -n $last ]] && ! grep -qxF "$last" "$trusted_file" 2>/dev/null; then
    rows+=($'\U000f012c\t'"Always accept from $last")
  fi
  while IFS= read -r name; do
    [[ -n $name ]] && rows+=($'\U000f0156\t'"Ask again for $name")
  done < <(cat "$trusted_file" 2>/dev/null)
  if (( ${#rows[@]} == 0 )); then
    notify-send --app-name="Quick Share" "Quick Share: no devices to trust yet" \
      "Receive a file from your phone first, then it can be accepted without asking."
    return
  fi
  choice=$(printf '%s\n' "${rows[@]}" | omarchy-menu-select "Accept without asking" -- --width 500) || return 0
  case $choice in
    "Always accept from "*) trust add "${choice#Always accept from }" >/dev/null ;;
    "Ask again for "*) trust remove "${choice#Ask again for }" >/dev/null ;;
  esac
}

# Rows are "<glyph><TAB><label>"; omarchy-menu-select returns the label.
menu() {
  installed || die "quickshare-direct is not installed"
  local rows=() shot choice
  if sending; then rows+=($'\U000f0156\tCancel sending'); fi
  # "Stop receiving" stays out of the first row, where a stray Enter would pick it.
  receiving || rows+=($'\U000f0497\tStart receiving')
  rows+=($'\U000f0552\tSend a file…')
  shot=$(latest_screenshot)
  [[ -n $shot ]] && rows+=($'\U000f0e51\tSend latest screenshot')
  rows+=($'\U000f01da\tOpen Downloads')
  receiving && rows+=($'\U000f1514\tStop receiving')
  if fast; then rows+=($'\U000f140b\tFast Wi-Fi: on (turn off)'); else rows+=($'\U000f140b\tFast Wi-Fi: off (turn on)'); fi
  rows+=($'\U000f0565\tTrusted devices…')
  rows+=($'\U000f04d9\tCheck setup')
  choice=$(printf '%s\n' "${rows[@]}" | omarchy-menu-select "Quick Share" -- --width 400) || exit 0
  case $choice in
    "Cancel sending") cancel ;;
    "Stop receiving") menu_stop_receiving ;;
    "Start receiving") set_receive on ;;
    "Fast Wi-Fi: on"*) set_fast off ;;
    "Fast Wi-Fi: off"*) set_fast on ;;
    "Send a file…") send ;;
    "Send latest screenshot") send "$shot" ;;
    "Open Downloads") xdg-open "$(downloads_dir)" >/dev/null 2>&1 & ;;
    "Trusted devices…") trust_menu ;;
    "Check setup") omarchy-launch-floating-terminal-with-presentation "$here/quickshare doctor" ;;
  esac
}

case ${1:-status} in
  status) status ;;
  receive) set_receive "${2:-toggle}" "${3:-}" ;;
  send) shift; send "$@" ;;
  cancel) cancel ;;
  devices) devices ;;
  fast) set_fast "${2:-}" ;;
  audio) set_audio "${2:-}" ;;
  audio-guard) audio_guard ;;
  audio-restore) audio_restore ;;
  trust) shift; trust "$@" ;;
  downloads) xdg-open "$(downloads_dir)" >/dev/null 2>&1 & ;;
  menu) menu ;;
  doctor) doctor ;;
  *) sed -n '6,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
