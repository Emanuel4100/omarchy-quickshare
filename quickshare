#!/usr/bin/env bash
# Quick Share for Omarchy: a thin wrapper around quickshare-direct, which speaks
# Google/Samsung Quick Share over Bluetooth (+ Wi-Fi Direct when it can), so the
# phone and PC don't need to share a Wi-Fi network.
#
#   quickshare status              JSON: installed, receiving, fast
#   quickshare receive on|off|toggle
#   quickshare send [file...]      send to a device in receive mode; no args opens a picker
#   quickshare downloads           open the folder received files go to
#   quickshare fast on|off         Wi-Fi Direct for transfers (pauses this PC's Wi-Fi meanwhile)
#   quickshare menu                everything above in an Omarchy menu (the bar's right click)
#   quickshare doctor              check the setup and say how to fix what's missing
set -uo pipefail

here=$(dirname "$(readlink -f "$0")")
unit=quickshare-direct.service
fast_helper=/usr/local/lib/omarchy-quickshare/quickshare-fastlink
fast_dropin=/etc/systemd/system/quickshare-ap@.service.d/50-omarchy-fastlink.conf
env_file=$HOME/.config/quickshare-direct/env

# Our notify-send shim turns Accept/Decline (and the "several devices" question)
# into an Omarchy menu; see bin/notify-send.
export PATH="$here/bin:${OMARCHY_PATH:-/usr/share/omarchy}/bin:$PATH"

die() { echo "quickshare: $*" >&2; exit 1; }

installed() { command -v quickshare-direct >/dev/null 2>&1; }
receiving() { systemctl --user is-active --quiet "$unit"; }
fast() { [[ -e $fast_dropin ]]; }

status() {
  local inst=false recv=false fst=false
  installed && inst=true
  receiving && recv=true
  fast && fst=true
  printf '{"installed":%s,"receiving":%s,"fast":%s}\n' "$inst" "$recv" "$fst"
}

# enable/disable too, so the choice survives a re-login.
set_receive() {
  installed || die "quickshare-direct is not installed"
  local want=${1:-toggle}
  if [[ $want == toggle ]]; then
    if receiving; then want=off; else want=on; fi
  fi
  case $want in
    on) systemctl --user enable --now "$unit" ;;
    off) systemctl --user disable --now "$unit" ;;
    *) die "receive takes on, off or toggle" ;;
  esac
}

# quickshare-direct's own Wi-Fi Direct link dies at once under NetworkManager, so
# transfers stay on Bluetooth (~7 KB/s). "fast on" swaps in system/quickshare-fastlink,
# which takes the Wi-Fi away from NetworkManager for the transfer. It runs as root,
# so it's copied to /usr/local (root-owned), never run from this user-writable folder.
set_fast() {
  installed || die "quickshare-direct is not installed"
  case ${1:-} in
    on)
      pkexec /bin/sh -c 'install -Dm755 "$1" "$3" && install -Dm644 "$2" "$4" && systemctl daemon-reload' sh \
        "$here/system/quickshare-fastlink" "$here/system/quickshare-ap@.service.d/50-omarchy-fastlink.conf" \
        "$fast_helper" "$fast_dropin" || die "not installed"
      echo "Wi-Fi Direct on: this PC's Wi-Fi pauses during transfers" ;;
    off)
      pkexec /bin/sh -c 'rm -f "$1" "$2" && rmdir --ignore-fail-on-non-empty "${2%/*}" "${1%/*}"; systemctl daemon-reload' sh \
        "$fast_helper" "$fast_dropin" || die "not removed"
      echo "Wi-Fi Direct off: transfers use Bluetooth" ;;
    *) fast && echo on || echo off ;;
  esac
}

send() {
  installed || die "quickshare-direct is not installed"
  local files=() f out to=""
  if (( $# == 0 )); then
    f=$(bash "$here/scripts/pick_file.sh") || exit 0
    [[ -n $f ]] || exit 0
    files=("$f")
  else
    for f in "$@"; do
      [[ -e $f ]] || die "no such file: $f"
      files+=("$(readlink -f "$f")")
    done
  fi

  # quickshare-direct posts its own "Looking for a phone…" and result notifications.
  out=$(quickshare-direct send "${files[@]}" 2>&1)
  local code=$?

  # Several devices in receive mode: ask which one, then send again with --to.
  if (( code != 0 )) && [[ $out == *"pick one with --to NAME:"* ]]; then
    local names
    names=$(sed -n 's/.*pick one with --to NAME: *//p' <<< "$out" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep .)
    to=$(omarchy-menu-select "Send ${files[0]##*/} to" -- --width 500 <<< "$names") || exit 0
    out=$(quickshare-direct send --to "$to" "${files[@]}" 2>&1)
    code=$?
  fi

  if (( code != 0 )); then
    printf '%s\n' "$out" >&2
    exit "$code"
  fi
}

# One line per part of the setup: ✓ fine, ! worth knowing, ✗ broken (with the fix). Exits 1 on any ✗.
doctor() {
  local g='' y='' r='' n='' bad=0 v cc pid
  [[ -t 1 ]] && g=$'\e[32m' y=$'\e[33m' r=$'\e[31m' n=$'\e[0m'
  pass() { printf '  %s✓%s %s\n' "$g" "$n" "$1"; }
  warn() { printf '  %s!%s %s\n' "$y" "$n" "$1"; }
  fail() { printf '  %s✗%s %s\n      fix: %s\n' "$r" "$n" "$1" "$2"; bad=1; }

  if installed; then
    v=$(pacman -Q quickshare-direct 2>/dev/null | awk '{print $2}')
    pass "quickshare-direct ${v:-installed}"
  else
    fail "quickshare-direct isn't installed" "$here/install.sh"
  fi

  if receiving; then
    pass "Receiving: phones can pick $(sed -n 's/^QSD_NAME=//p' "$env_file" 2>/dev/null | tail -1 | grep . || uname -n)"
  else
    fail "Receiving is off, so phones can't see this PC" "quickshare receive on"
  fi

  if [[ $(timeout 3 bluetoothctl show 2>/dev/null) == *'Powered: yes'* ]]; then
    pass "Bluetooth on"
  else
    fail "Bluetooth is off or missing" "bluetoothctl power on"
  fi
  if installed && ! systemctl is-enabled -q quickshare-bt-connectable.service 2>/dev/null; then
    fail "Bluetooth isn't kept connectable for phones" "sudo systemctl enable --now quickshare-bt-connectable"
  fi

  if grep -q "^PATH=$here/bin:" "$env_file" 2>/dev/null; then
    pid=$(systemctl --user show -p MainPID --value "$unit" 2>/dev/null)
    if [[ ${pid:-0} != 0 ]] && ! grep -qz "^PATH=$here/bin:" "/proc/$pid/environ" 2>/dev/null; then
      fail "The receiver started before its prompts were routed" "systemctl --user restart $unit"
    else
      pass "Accept/Decline prompts open as an Omarchy menu"
    fi
  else
    fail "Accept/Decline prompts can't be answered (Omarchy popups have no buttons)" "$here/install.sh"
  fi

  [[ -f $HOME/.local/share/icons/hicolor/scalable/apps/omarchy-quickshare.svg ]] ||
    warn "Notifications show a letter instead of the Quick Share icon ($here/install.sh installs it)"

  if systemctl is-active -q ufw 2>/dev/null; then
    if grep -q 'quickshare-direct' /etc/ufw/user.rules 2>/dev/null; then
      pass "Firewall: ufw allows quickshare-direct"
    else
      fail "Firewall: ufw blocks transfers over your Wi-Fi network" "sudo ufw allow quickshare-direct"
    fi
  fi

  cc=$(iw reg get 2>/dev/null | awk '/^global/ { g = 1; next } g && /^country/ { sub(":", "", $2); print $2; exit }')
  if [[ -n $cc && $cc != 00 ]]; then
    pass "Wi-Fi region: $cc"
  else
    warn "Wi-Fi region not set, so direct Wi-Fi stays on 2.4 GHz (sudo iw reg set XX, or $here/install.sh)"
  fi

  if [[ $(iw phy 2>/dev/null) == *P2P-GO* ]]; then
    if fast; then pass "Fast Wi-Fi: on (this PC's Wi-Fi pauses during transfers)"
    else warn "Fast Wi-Fi: off, transfers use Bluetooth (quickshare fast on)"; fi
  else
    warn "This Wi-Fi card can't do Wi-Fi Direct, so transfers use Bluetooth"
  fi

  if omarchy-plugin-list --json 2>/dev/null | jq -e 'any(.[]; .id == "emanuel.quickshare" and .enabled)' >/dev/null; then
    pass "Bar icon on"
  else
    fail "Bar icon off" "omarchy plugin enable emanuel.quickshare"
  fi

  if [[ $(readlink -f "$HOME/.local/bin/quickshare" 2>/dev/null) != "$here/quickshare" ]]; then
    warn "The quickshare command isn't in ~/.local/bin ($here/install.sh links it)"
  fi
  return "$bad"
}

downloads_dir() { xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads"; }

latest_screenshot() {
  local dir=${OMARCHY_SCREENSHOT_DIR:-$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")}
  find "$dir" -maxdepth 1 -type f -iname '*.png' -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2-
}

# Rows are "<glyph><TAB><label>"; omarchy-menu-select returns the label.
menu() {
  installed || die "quickshare-direct is not installed"
  local rows=() shot choice
  if receiving; then rows+=($'\U000f1514\tStop receiving'); else rows+=($'\U000f0497\tStart receiving'); fi
  if fast; then rows+=($'\U000f140b\tFast Wi-Fi: on (turn off)'); else rows+=($'\U000f140b\tFast Wi-Fi: off (turn on)'); fi
  rows+=($'\U000f0552\tSend a file…')
  shot=$(latest_screenshot)
  [[ -n $shot ]] && rows+=($'\U000f0e51\tSend latest screenshot')
  rows+=($'\U000f01da\tOpen Downloads')
  rows+=($'\U000f04d9\tCheck setup')
  choice=$(printf '%s\n' "${rows[@]}" | omarchy-menu-select "Quick Share" -- --width 400) || exit 0
  case $choice in
    "Stop receiving") set_receive off ;;
    "Start receiving") set_receive on ;;
    "Fast Wi-Fi: on"*) set_fast off ;;
    "Fast Wi-Fi: off"*) set_fast on ;;
    "Send a file…") send ;;
    "Send latest screenshot") send "$shot" ;;
    "Open Downloads") xdg-open "$(downloads_dir)" >/dev/null 2>&1 & ;;
    "Check setup") omarchy-launch-floating-terminal-with-presentation "$here/quickshare doctor" ;;
  esac
}

case ${1:-status} in
  status) status ;;
  receive) set_receive "${2:-toggle}" ;;
  send) shift; send "$@" ;;
  fast) set_fast "${2:-}" ;;
  downloads) xdg-open "$(downloads_dir)" >/dev/null 2>&1 & ;;
  menu) menu ;;
  doctor) doctor ;;
  *) sed -n '6,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
