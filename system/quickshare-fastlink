#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
# Derived from quickshare-direct's quickshare-ap (GPL-3.0); see LICENSE-GPL-3.0.
# quickshare-fastlink: Wi-Fi Direct link for Quick Share transfers that NetworkManager can't break,
# keeping this PC on its Wi-Fi network meanwhile. Runs as root in place of quickshare-direct's
# /usr/lib/quickshare-direct/quickshare-ap (installed by `quickshare fast on` as a drop-in for
# quickshare-ap@.service); derived from that helper (0.1.5).
#
# Why: NetworkManager owns wpa_supplicant's station interface and with it the P2P device, and it
# removes any Wi-Fi Direct group started there that it didn't ask for: its GroupStarted handler
# wraps the new group interface, finds no connection attempt ("P2P: WPA supplicant notified a group
# start but we are not trying to connect! Ignoring the event."), and dropping that wrapper calls
# wpa_supplicant's RemoveInterface on the group (AP-DISABLED within a millisecond). There's no
# setting against it. So the station is taken away from NetworkManager for the transfer and added
# to wpa_supplicant by us, which makes its P2P device ours too.
#
# Two ways, tried in this order:
#   keep:  rejoin the same Wi-Fi network on our interface right away (the connection's saved
#          WPA2/WPA3 password; same address, routes and DNS, so connections survive) and host the
#          group next to it: on the station's channel if we may transmit there (2.4 GHz), else on
#          2.4 GHz as a second channel (cards that run two channels at once, iw phy "#channels <=
#          2"; Intel marks most of 5 GHz "no IR"). The internet drops for a few seconds while the
#          station switches over, at the start and the end, and the radio alternates between the
#          two channels (about half the speed of the link alone).
#   pause: host the group alone; the Wi-Fi connection pauses for the transfer.
# Afterwards the station goes back to NetworkManager, which reconnects it.
#
#   quickshare-fastlink          run the link (as root, from quickshare-ap@.service)
#   quickshare-fastlink --plan   print the way a transfer would use now ("keep 2437", "pause
#                                2437"); needs no root and changes nothing
#   quickshare-fastlink --check  try the "keep" way without a phone (as root): rejoin the network,
#                                reach the gateway, start the group, report each step, then give
#                                the Wi-Fi back (the internet drops for a few seconds, twice)
#
# Environment: QS_STA (station interface, default: first managed Wi-Fi interface),
#              QS_KEEP_WIFI (auto: keep, else pause; never: always pause),
#              QS_GO_FREQS (group frequencies in order of preference, MHz; the first one our radio
#              may transmit on is used; default "2437 2412 2462 5180 5745"),
#              QS_USER (user who may read the credentials; quickshare-ap@USER sets it), else
#              QS_GROUP (default users), QS_SUBNET (default 10.42.0),
#              QS_NFT_CHAIN (see fw_allow).
# Needs: iw, iproute2, dnsmasq, busctl (systemd), nmcli, wpa_supplicant with P2P + D-Bus;
# resolvectl when systemd-resolved runs.
set -euo pipefail

STA=${QS_STA:-$(iw dev | awk '/Interface/{i=$2} /type managed/{print i; exit}')}
[ -n "$STA" ] || { echo "quickshare-fastlink: no Wi-Fi station interface" >&2; exit 1; }

WPAS=fi.w1.wpa_supplicant1
# wpa_supplicant D-Bus object of an interface name (e.g. wlo1), or nothing.
wpas_obj() {
  local p
  for p in $(busctl get-property $WPAS /fi/w1/wpa_supplicant1 $WPAS Interfaces | grep -o '"/[^"]*"' | tr -d '"'); do
    [ "$(busctl get-property $WPAS "$p" $WPAS.Interface Ifname 2>/dev/null)" = "s \"$1\"" ] && { echo "$p"; return 0; }
  done
  return 1
}

# Whether we may start a network on a frequency: listed for our phy, and not marked "radar
# detection" (DFS), "no IR" or "disabled" (iw phy: "* 5500.0 MHz [100] (26.0 dBm) (radar detection)").
PHY=$(cat "/sys/class/net/$STA/phy80211/name" 2>/dev/null || true)
PHYINFO=$(iw phy ${PHY:+"$PHY"} info 2>/dev/null || iw phy 2>/dev/null || true)
usable() {
  local l
  l=$(printf '%s\n' "$PHYINFO" | grep -E "^[[:space:]]+\* $1(\.0)? MHz" | head -1)
  [ -n "$l" ] && ! printf '%s\n' "$l" | grep -qE "radar detection|no IR|disabled"
}

# Whether the card runs a group owner on a second channel next to the station: one interface
# combination with P2P-GO and "#channels <= 2" or more (a combination can wrap onto a second line).
two_channels() {
  printf '%s\n' "$PHYINFO" | awk '
    function check(  n) {
      if (combo ~ /P2P-GO/ && match(combo, /#channels <= [0-9]+/)) {
        n = substr(combo, RSTART + 13, RLENGTH - 13); if (n + 0 >= 2) found = 1
      }
      combo = ""
    }
    /valid interface combinations/ { inside = 1; next }
    inside && /^\t\t/ { if ($0 ~ /^\t\t \* /) check(); combo = combo $0; next }
    inside { check(); inside = 0 }
    END { check(); exit !found }'
}

PAUSE_FREQ=
for f in ${QS_GO_FREQS:-2437 2412 2462 5180 5745}; do
  if usable "$f"; then PAUSE_FREQ=$f; break; fi
done

# The connection to rejoin: a WPA2/WPA3-Personal one whose password NetworkManager stores itself
# (psk-flags 0; one kept in a user's keyring isn't readable here).
STA_FREQ=$(iw dev "$STA" info 2>/dev/null | sed -n 's/.*channel [0-9]* (\([0-9]*\) MHz.*/\1/p' || true)
STA_CONN=$(nmcli -g UUID,DEVICE connection show --active 2>/dev/null |
  awk -F: -v d="$STA" '$2 == d { print $1; exit }' || true)
nm_get() { nmcli --escape no "$@" connection show uuid "$STA_CONN" 2>/dev/null; }
KEEP_FREQ=
if [ -n "$STA_FREQ" ] && [ -n "$STA_CONN" ] && [ "${QS_KEEP_WIFI:-auto}" != never ]; then
  KEY_MGMT=$(nm_get -g 802-11-wireless-security.key-mgmt || true)
  PSK_FLAGS=$(nm_get -g 802-11-wireless-security.psk-flags || true)
  case $KEY_MGMT in
    wpa-psk | sae)
      if [ "${PSK_FLAGS%% *}" = 0 ]; then
        if usable "$STA_FREQ"; then KEEP_FREQ=$STA_FREQ
        elif [ -n "$PAUSE_FREQ" ] && two_channels; then KEEP_FREQ=$PAUSE_FREQ
        fi
      fi ;;
  esac
fi

if [ "${1:-}" = --plan ]; then
  if [ -n "$KEEP_FREQ" ]; then echo "keep $KEEP_FREQ"; else echo "pause $PAUSE_FREQ"; fi
  exit 0
fi

CHECK=
if [ "${1:-}" = --check ]; then
  [ "$(id -u)" = 0 ] || { echo "quickshare-fastlink: --check needs root (sudo)" >&2; exit 1; }
  [ -n "$KEEP_FREQ" ] || { echo "quickshare-fastlink: this network/card would pause the Wi-Fi (no keep way to check)" >&2; exit 1; }
  CHECK=1
  # wpa_supplicant's debug log for the check, to show why a rejoin fails; put back on exit.
  DEBUG_PREV=$(busctl get-property $WPAS /fi/w1/wpa_supplicant1 $WPAS DebugLevel 2>/dev/null | sed 's/^s "\(.*\)"$/\1/')
  busctl set-property $WPAS /fi/w1/wpa_supplicant1 $WPAS DebugLevel s debug 2>/dev/null || DEBUG_PREV=
fi
# --check: time since start, for its report.
t0=$(date +%s.%N)
since() { awk -v now="$(date +%s.%N)" -v t0="$t0" 'BEGIN { printf "%.1f s", now - t0 }'; }

GROUP=${QS_GROUP:-users}
[ -n "${QS_USER:-}" ] && GROUP=$(id -gn "$QS_USER")
NET=${QS_SUBNET:-10.42.0}
DIR=${RUNTIME_DIRECTORY:-/run/quickshare}
mkdir -p "$DIR"

# Let the phone reach us on the group interface: firewalld (trusted zone), ufw (allow in on it),
# else an nftables rule in QS_NFT_CHAIN="family table chain" (skipped if that chain doesn't exist).
NFT_CHAIN=${QS_NFT_CHAIN:-inet nixos-fw input-allow}
fw_allow() {
  if command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --zone=trusted --add-interface="$1" >/dev/null && FW_FIREWALLD=$1
  elif command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow in on "$1" comment quickshare >/dev/null && FW_UFW=$1
  elif command -v nft >/dev/null; then
    # shellcheck disable=SC2086
    NFT_HANDLE=$(nft --echo --handle insert rule $NFT_CHAIN iifname "$1" accept comment quickshare 2>/dev/null |
      sed -n 's/.*# handle \([0-9]*\).*/\1/p') || true
  fi
}

# End the group (if any) and wait for its interface to go, so a second try can't mistake it for its own.
stop_p2p() {
  local i
  [ -n "${GOBJ:-}" ] && busctl call $WPAS "$GOBJ" $WPAS.Interface.P2PDevice Disconnect 2>/dev/null
  GOBJ=
  for i in $(seq 20); do
    compgen -G "/sys/class/net/p2p-$STA-*" >/dev/null || break
    sleep 0.1
  done
  IF=
  return 0
}

cleanup() {
  set +e  # finish every step, above all giving the station back
  [ -n "${DEBUG_PREV:-}" ] && busctl set-property $WPAS /fi/w1/wpa_supplicant1 $WPAS DebugLevel s "$DEBUG_PREV" 2>/dev/null
  [ -n "${FW_FIREWALLD:-}" ] && firewall-cmd --zone=trusted --remove-interface="$FW_FIREWALLD" >/dev/null 2>&1
  [ -n "${FW_UFW:-}" ] && ufw delete allow in on "$FW_UFW" >/dev/null 2>&1
  # shellcheck disable=SC2086
  [ -n "${NFT_HANDLE:-}" ] && nft delete rule $NFT_CHAIN handle "$NFT_HANDLE" 2>/dev/null
  [ -n "${DNSMASQ:-}" ] && kill "$DNSMASQ" 2>/dev/null
  stop_p2p
  rm -f "$DIR/credentials" "$DIR/leases"
  if [ -n "${OWN_IFACE:-}" ]; then
    busctl call $WPAS /fi/w1/wpa_supplicant1 $WPAS RemoveInterface o "$OWN_IFACE" 2>/dev/null
  fi
  if [ -n "${STA_UNMANAGED:-}" ]; then
    echo "quickshare-fastlink: giving $STA back to NetworkManager${STA_CONN:+ (connection $STA_CONN)}"
    nmcli device set "$STA" managed yes 2>/dev/null
    if [ -z "${STA_CONN:-}" ] || ! nmcli -w 0 connection up uuid "$STA_CONN" ifname "$STA" >/dev/null 2>&1; then
      nmcli -w 0 device connect "$STA" >/dev/null 2>&1
    fi
    rm -f "/run/quickshare-reconnect-$STA"
  fi
  return 0
}
trap cleanup EXIT
trap 'exit 0' TERM INT

# The station's IPv4 addresses, routes and DNS servers, to put back after the switch-over (taking
# the link from NetworkManager and down drops the routes, and resolved may forget its DNS).
IP4_ADDRS=$(ip -4 -o addr show dev "$STA" scope global 2>/dev/null | awk '{print $4}')
IP4_ROUTES=$(ip -4 route show dev "$STA" 2>/dev/null)
DNS=$(resolvectl dns "$STA" 2>/dev/null | sed 's/^[^:]*: *//')
DOMAINS=$(resolvectl domain "$STA" 2>/dev/null | sed 's/^[^:]*: *//')
restore_ip() {
  local a r
  for a in $IP4_ADDRS; do ip addr replace "$a" dev "$STA" 2>/dev/null; done
  # The subnet first: the default route's gateway must be reachable when it goes in.
  while IFS= read -r r; do
    # shellcheck disable=SC2086 # a route is several words
    [ -n "$r" ] && ip route replace $r dev "$STA" 2>/dev/null
  done < <(grep -v '^default' <<< "$IP4_ROUTES"; grep '^default' <<< "$IP4_ROUTES")
  if [ -n "$DNS" ] && command -v resolvectl >/dev/null; then
    # shellcheck disable=SC2086
    resolvectl dns "$STA" $DNS 2>/dev/null
    # shellcheck disable=SC2086
    [ -n "$DOMAINS" ] && resolvectl domain "$STA" $DOMAINS 2>/dev/null
    resolvectl default-route "$STA" yes 2>/dev/null
  fi
  return 0
}

# Take the station away from NetworkManager and add it to wpa_supplicant ourselves (its P2P device
# comes with it); sets OWN_IFACE. If we die before giving it back, the unit's ExecStopPost does it
# from this marker.
take_station() {
  local i
  echo "$STA_CONN" > "/run/quickshare-reconnect-$STA"
  for i in /sys/class/net/p2p-"$STA"-*; do [ -e "$i" ] && iw dev "${i##*/}" del 2>/dev/null; done
  echo "quickshare-fastlink: taking $STA from NetworkManager for the transfer"
  nmcli -w 10 device set "$STA" managed no
  STA_UNMANAGED=1
  for i in $(seq 50); do wpas_obj "$STA" >/dev/null || break; sleep 0.1; done
  OWN_IFACE=$(busctl call $WPAS /fi/w1/wpa_supplicant1 $WPAS CreateInterface 'a{sv}' 2 \
    Ifname s "$STA" Driver s nl80211 | sed -n 's/^o "\(.*\)"$/\1/p')
  [ -n "$OWN_IFACE" ] || { echo "quickshare-fastlink: wpa_supplicant wouldn't take $STA" >&2; return 1; }
}

# Join the connection's network again on our interface, with the network block NetworkManager
# itself gives wpa_supplicant for it (ssid, scan_ssid, key_mgmt, auth_alg, psk).
join_station() {
  local ssid psk key_mgmt="WPA-PSK WPA-PSK-SHA256 FT-PSK SAE FT-SAE" i
  ssid=$(nm_get -g 802-11-wireless.ssid) && psk=$(nm_get -s -g 802-11-wireless-security.psk) || return 1
  [ -n "$ssid" ] && [ -n "$psk" ] || return 1
  [ "$KEY_MGMT" = sae ] && key_mgmt="SAE FT-SAE"
  STA_NET=$(busctl call $WPAS "$OWN_IFACE" $WPAS.Interface AddNetwork 'a{sv}' 5 \
    ssid s "$ssid" psk s "$psk" key_mgmt s "$key_mgmt" auth_alg s OPEN scan_ssid s 1 |
    sed -n 's/^o "\(.*\)"$/\1/p') || return 1
  [ -n "$STA_NET" ] || return 1
  busctl call $WPAS "$OWN_IFACE" $WPAS.Interface SelectNetwork o "$STA_NET" || return 1
  local state last=
  for i in $(seq 150); do
    state=$(busctl get-property $WPAS "$OWN_IFACE" $WPAS.Interface State 2>/dev/null | sed 's/^s "\(.*\)"$/\1/')
    # Each state change, for the journal: where a failed rejoin got stuck.
    [ "$state" != "$last" ] && echo "quickshare-fastlink: $STA: $state ($(since))" && last=$state
    [ "$state" = completed ] && return 0
    sleep 0.1
  done
  echo "quickshare-fastlink: $STA: still $state; networks seen: $(iw dev "$STA" scan dump 2>/dev/null | sed -n 's/^\tSSID: //p' | sort -u | paste -sd ',')" >&2
  return 1
}

# Leave the network again (the group then gets the radio alone).
leave_station() {
  busctl call $WPAS "$OWN_IFACE" $WPAS.Interface RemoveAllNetworks 2>/dev/null
  return 0
}

# Wi-Fi Direct group owner on GO_FREQ via our wpa_supplicant interface; sets IF, SSID, PASS,
# GOBJ, GROUP_FREQ.
start_p2p() {
  local dev=$OWN_IFACE grp ssid_bytes i o1 o2 o3
  # Hand the phone its address in the WPA handshake (no DHCP round inside Nearby's ~4 s join
  # timeout); dnsmasq stays as the fallback for .10-.99.
  IFS=. read -r o1 o2 o3 <<< "$NET"
  busctl set-property $WPAS "$dev" $WPAS.Interface.P2PDevice P2PDeviceConfig 'a{sv}' 4 \
      IpAddrGo ay 4 "$o1" "$o2" "$o3" 1 IpAddrMask ay 4 255 255 255 0 \
      IpAddrStart ay 4 "$o1" "$o2" "$o3" 100 IpAddrEnd ay 4 "$o1" "$o2" "$o3" 199 2>/dev/null ||
    echo "quickshare-fastlink: no EAPOL IP allocation; phones use DHCP" >&2
  local f=() n=0
  [ -n "$GO_FREQ" ] && { f=(frequency i "$GO_FREQ"); n=1; }
  # Widest first: without ht40/vht/he the group runs 802.11n at 20 MHz.
  busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 4)) \
      persistent b false "${f[@]}" ht40 b true vht b true he b true >/dev/null ||
    busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 3)) \
      persistent b false "${f[@]}" ht40 b true vht b true >/dev/null ||
    busctl call $WPAS "$dev" $WPAS.Interface.P2PDevice GroupAdd 'a{sv}' $((n + 1)) \
      persistent b false "${f[@]}" >/dev/null || return 1
  for i in $(seq 50); do
    IF=$(ls /sys/class/net | grep "^p2p-$STA-" | head -1 || true)
    [ -n "$IF" ] && GOBJ=$(wpas_obj "$IF") && break
    sleep 0.1
  done
  [ -n "${GOBJ:-}" ] || { echo "quickshare-fastlink: P2P group interface didn't appear" >&2; return 1; }
  for i in $(seq 50); do
    grp=$(busctl get-property $WPAS "$GOBJ" $WPAS.Interface.P2PDevice Group 2>/dev/null | grep -o '"/[^"]*"' | tr -d '"' || true)
    [ -n "$grp" ] && [ "$grp" != "/" ] && break
    sleep 0.1
  done
  # SSID property is "ay N b1 b2 ...": bytes → string
  ssid_bytes=$(busctl get-property $WPAS "$grp" $WPAS.Group SSID | cut -d' ' -f3-)
  SSID=$(for b in $ssid_bytes; do printf "\\x$(printf %02x "$b")"; done)
  PASS=$(busctl get-property $WPAS "$grp" $WPAS.Group Passphrase | sed 's/^s "\(.*\)"$/\1/')
  GROUP_FREQ=$(busctl get-property $WPAS "$grp" $WPAS.Group Frequency 2>/dev/null | awk '{print $2}' || true)
  [ -n "$SSID" ] && [ -n "$PASS" ]
}

# Still up a second later: a refused channel takes the group down within milliseconds.
group_alive() {
  sleep 1
  [ -e "/sys/class/net/$IF" ] && iw dev "$IF" info 2>/dev/null | grep -q 'type P2P-GO'
}

take_station || exit 1
WAY=pause GO_FREQ=$PAUSE_FREQ
if [ -n "$KEEP_FREQ" ]; then
  if join_station; then
    restore_ip
    WAY=keep GO_FREQ=$KEEP_FREQ
    echo "quickshare-fastlink: $STA back on its network ($STA_FREQ MHz)"
  else
    echo "quickshare-fastlink: couldn't rejoin the network; pausing the Wi-Fi instead" >&2
    leave_station
  fi
fi
if ! { start_p2p && group_alive; }; then
  [ "$WAY" = keep ] || { echo "quickshare-fastlink: Wi-Fi Direct failed" >&2; exit 1; }
  echo "quickshare-fastlink: no group next to the network on $GO_FREQ MHz; pausing the Wi-Fi instead" >&2
  stop_p2p
  leave_station
  WAY=pause GO_FREQ=$PAUSE_FREQ
  { start_p2p && group_alive; } || { echo "quickshare-fastlink: Wi-Fi Direct failed" >&2; exit 1; }
fi
LINK_FREQ=${GROUP_FREQ:-$GO_FREQ}

if [ -n "$CHECK" ]; then
  gw=$(ip -4 route show default dev "$STA" 2>/dev/null | awk '{print $3; exit}')
  if [ "$WAY" != keep ]; then
    echo "check: FAILED, the Wi-Fi would pause. wpa_supplicant on $STA meanwhile:"
    journalctl -u wpa_supplicant --since "@${t0%.*}" -o cat 2>/dev/null |
      grep -E "^$STA: .*(skip|reject|selected|No suitable|[Ss]can|Trying|ssid=|disabled|failed|Failed)|^ +(skip|reject|selected)" |
      grep -v 'BSS: ' | tail -40 | sed 's/^/  /' 
  elif [ -n "$gw" ] && ping -c 2 -W 2 -I "$STA" "$gw" >/dev/null 2>&1; then
    echo "check: OK, back on the network and the gateway $gw answers; group up on $LINK_FREQ MHz ($(since))"
  else
    echo "check: rejoined and group up on $LINK_FREQ MHz, but the gateway ${gw:-(no route)} doesn't answer"
  fi
  exit 0
fi

ip addr add "$NET.1/24" dev "$IF"
ip link set "$IF" up
fw_allow "$IF"
dnsmasq --keep-in-foreground --conf-file=/dev/null --port=0 \
  --interface="$IF" --bind-interfaces --except-interface=lo \
  --dhcp-range="$NET.10,$NET.99,255.255.255.0,1h" \
  --dhcp-leasefile="$DIR/leases" &
DNSMASQ=$!

umask 027
printf 'mode=p2p\nssid=%s\npassword=%s\nfrequency=%s\ngateway=%s\n' "$SSID" "$PASS" "$LINK_FREQ" "$NET.1" \
  > "$DIR/credentials.tmp"
chgrp "$GROUP" "$DIR/credentials.tmp" "$DIR"
chmod 0750 "$DIR"
mv "$DIR/credentials.tmp" "$DIR/credentials"
if [ "$WAY" = keep ]; then
  echo "quickshare-fastlink: p2p $SSID on $IF ($LINK_FREQ MHz), next to $STA ($STA_FREQ MHz): Wi-Fi kept"
else
  echo "quickshare-fastlink: p2p $SSID on $IF ($LINK_FREQ MHz), $STA paused"
fi

wait "$DNSMASQ"
